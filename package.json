{
  "name": "async-task-mapping",
  "version": "2.0.0",
  "description": "Asynchronous Task Manager.",
  "keywords": [
    "async",
    "task",
    "mapping",
    "list",
    "await",
    "promise",
    "batch",
    "request",
    "manage"
  ],
  "homepage": "https://github.com/TNT-03/async-task-mapping#readme",
  "bugs": {
    "url": "https://github.com/TNT-03/async-task-mapping/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TNT-03/async-task-mapping.git"
  },
  "license": "MIT",
  "author": "Jiegang Liang (t.n.t)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --typecheck",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/check-package.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run test:package"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@arethetypeswrong/core": "^0.18.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.13.1"
}
